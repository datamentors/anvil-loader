# Copy this file to unicast.env and review every value for the workcell.
# Network addresses belong in this robot-local profile, not in source code.
ANVIL_ROBOT_INTERFACE=replace-with-robot-interface
ANVIL_ROBOT_IP=replace-with-robot-lan-ip
ANVIL_ROBOT_PREFIX_LENGTH=24
ANVIL_GPU_IP=replace-with-inference-lan-ip
ANVIL_ROS_DOMAIN_ID=204

# CycloneDDS 0.10.5 defaults to an auto-participant ceiling of 9. The complete
# loader stack needs more participants, so retain reviewed finite headroom.
ANVIL_DDS_MAX_AUTO_PARTICIPANT_INDEX=31
ANVIL_DDS_MAX_MESSAGE_SIZE=1400B
ANVIL_DDS_FRAGMENT_SIZE=1344B
ANVIL_DDS_WHC_HIGH=8MB

# Real-hardware controller profile. Teleoperation remains disabled while an
# external inference workstation owns the command topics.
ANVIL_ARMS_CONTROL_CONFIG_FILE=openarm_inference.yaml
